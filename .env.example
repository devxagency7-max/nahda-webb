# Backend base path as consumed by the app (relative -> goes through the Vite dev proxy).
# In production this must point at wherever the API is actually reachable
# (ideally https, behind the same reverse proxy that serves the built app).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api/* to. Not read by the app itself.
VITE_API_PROXY_TARGET=https://srv1990155.hstgr.cloud
